{
  "name": "fotos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "eslint src tests scripts eslint.config.js",
    "build:legal": "node scripts/build-legal-docs.mjs",
    "smoke": "bash scripts/smoke.sh",
    "smoke:local": "bash scripts/smoke.sh http://127.0.0.1:8787",
    "predeploy:check": "wrangler versions upload --env= --dry-run --outdir /tmp/bundle-check",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:workers": "vitest run --project workers",
    "test:coverage": "vitest run --project unit --coverage",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260822.1",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.127.1"
  }
}
