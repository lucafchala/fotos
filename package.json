{
  "name": "fotos",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "eslint src tests scripts eslint.config.js",
    "build:legal": "node scripts/build-legal-docs.mjs",
    "build:fonts": "node scripts/build-fonts.mjs",
    "build:vendor": "node scripts/build-vendor.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "smoke": "bash scripts/smoke.sh",
    "smoke:local": "bash scripts/smoke.sh http://127.0.0.1:8787",
    "predeploy:check": "wrangler versions upload --env= --dry-run --outdir /tmp/bundle-check",
    "previa": "node scripts/previa-publica.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:workers": "vitest run --project workers",
    "test:coverage": "vitest run --project unit --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "verifica:navegador": "node scripts/verifica-navegador.mjs",
    "verifica:evento": "node scripts/verifica-evento.mjs",
    "verifica:galeria": "node scripts/verifica-galeria.mjs",
    "verifica:painel": "node --import ./scripts/node-com-workers.mjs scripts/verifica-painel.mjs",
    "verifica:previa": "node --import ./scripts/node-com-workers.mjs scripts/verifica-previa.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "undici": "^7.30.1",
    "zod": "^4.6.6"
  }
}
