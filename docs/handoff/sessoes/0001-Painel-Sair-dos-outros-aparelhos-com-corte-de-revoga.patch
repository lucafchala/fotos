+    // O prefixo das sessões não enxerga o marcador, e ele leva expiração (~25 h).
+    const sessoes = await env.FOTOS.list({ prefix: 'admin_session:' });
+    expect(sessoes.keys.map(k => k.name)).toEqual([chave(DONO)]);
