+export function scriptsSemNonce(html, nonce) {
+  return tagsDeAbertura(html)
+    .filter(t => t.tag === 'script')
+    .filter(t => !nonce || !t.attrs.some(a => a.nome === 'nonce' && a.valor === nonce))
